# Copy to .env and fill in. Never commit a real .env.
DATABASE_URL=postgres://user:pass@host:5432/dbname
PORT=8787
ADMIN_TOKEN=change-me

# Providers (free tiers). GEMINI_API_KEY switches embeddings/generation/judge
# from dev mode to production quality.
GEMINI_API_KEY=
GROQ_API_KEY=
JINA_API_KEY=
COHERE_API_KEY=

# Models
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
GEN_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash

# Corpus and eval
# CORPUS_DIR is where the markdown corpus lives (default: <repo root>/corpus).
CORPUS_DIR=./corpus
# EVAL_SET is the golden question set used by the eval harness
# (default: <repo root>/eval/golden_core_100.jsonl).
EVAL_SET=./eval/golden_core_100.jsonl
# EVIDENCE_MIN_DENSE is the minimum best dense cosine score for the evidence
# gate to attempt an answer when no rerank score exists (default 0.3;
# starting value, calibrated later on the golden set's unanswerable slice).
EVIDENCE_MIN_DENSE=0.3
